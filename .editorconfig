root = true

[*]
indent_style = space
insert_final_newline = true

[*.{cs,xaml,manifest,xml}]
end_of_line = crlf
indent_size = 4
# O gate (quality/policy.json) recusa linhas novas acima de 160 caracteres.
max_line_length = 160

[*.ps1]
end_of_line = crlf
indent_size = 4
# Somente ASCII: o Windows PowerShell 5.1 le arquivo sem BOM como ANSI.
charset = utf-8
max_line_length = 160

[*.{md,json,yml,yaml,toml,py}]
end_of_line = lf

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
